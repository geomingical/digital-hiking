        "summit_jitter_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "observation_error_c": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "min_temp_c": {
          "type": "number"
        },
        "max_temp_c": {
          "type": "number"
        },
        "gust_increment_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "max_wind_ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 50

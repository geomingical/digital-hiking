          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minItems": 2,
          "maxItems": 2
        },
        "wind_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hazard_probability": {
          "type": "object",
          "properties": {
            "thunder": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "front": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "typhoon": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fog": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ice": {
              "type": "number",
              "minimum": 0,
              "maximum": 1

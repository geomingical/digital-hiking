          "uniqueItems": true
        },
        "forecast": {
          "type": "object",
          "properties": {
            "spring": {
              "$ref": "#/$defs/forecastParameters"
            },
            "summer": {
              "$ref": "#/$defs/forecastParameters"
            },
            "autumn": {
              "$ref": "#/$defs/forecastParameters"
            },
            "winter": {
              "$ref": "#/$defs/forecastParameters"
            }
          },
          "required": [
            "spring",
            "summer",
            "autumn",
            "winter"
          ],
          "additionalProperties": false

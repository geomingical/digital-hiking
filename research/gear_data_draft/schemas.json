            "forest": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "ridge": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "summit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "descent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }

        "lapse_c_per_m",
        "summit_jitter_c",
        "observation_error_c",
        "min_temp_c",
        "max_temp_c",
        "gust_increment_ms",
        "max_wind_ms",
        "warning_cancel_flags",
        "winter_ice_action"

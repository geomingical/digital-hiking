                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "op": {
              "enum": [
                "eq",
                "gte"
              ]
            },
            "value": {
              "type": [
                "boolean",
                "number",
                "string"
              ]
            }
          },
          "required": [
            "path",
            "op",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "forecastParameters": {
      "type": "object",

/bin/bash -lc 'cat /workspace/digital-hiking/index.html' in /workspace/digital-hiking/research
 succeeded in 0ms:
<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<meta name="theme-color" content="#a9ddf5">
<meta name="description" content="數位登山：操控 Q 版登山客走一趟台灣山徑，在情境選擇中學會登山安全。">
<title>數位登山</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%23a9ddf5'/%3E%3Cpath d='M3 26 13 10l5 8 3-4 8 12z' fill='%235fa781'/%3E%3C/svg%3E">
<link rel="stylesheet" href="style.css">
</head>
<body>
<div id="app">
  <canvas id="scene" aria-label="登山步道場景"></canvas>

  <div id="stage">
    <header id="hud" hidden>
      <div class="hud-route">
        <div class="hud-route-top">
          <strong id="hud-stage">登山口</strong>
          <span id="hud-alt">海拔 1,850m</span>
        </div>
        <div class="route-bar" role="progressbar" aria-label="路線進度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="route-bar">
          <div class="route-fill" id="route-fill"></div>
          <div id="route-ticks"></div>
          <div class="route-dot" id="route-dot"></div>
        </div>
      </div>
      <div class="hud-risk" id="hud-risk">
        <svg id="risk-face" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
          <circle id="risk-face-bg" cx="16" cy="16" r="14.5" fill="#5bbf7a"/>
          <ellipse cx="11" cy="13.5" rx="2" ry="2.6" fill="#3a3028"/>
          <ellipse cx="21" cy="13.5" rx="2" ry="2.6" fill="#3a3028"/>
          <path id="risk-face-mouth" d="M10.5 19.5 Q16 25 21.5 19.5" fill="none" stroke="#3a3028" stroke-width="2" stroke-linecap="round"/>
          <path id="risk-face-drop" d="M26 6 q3 4 0 6 q-3-2 0-6" fill="#8fd3f4" opacity="0"/>
        </svg>
        <div class="risk-body">
          <div class="risk-top"><span>出事風險</span><b id="risk-num">0</b></div>

    const p = state.player;
    view.t += dt;
    state.riskView += (state.risk - state.riskView) * Math.min(1, dt * 2.6);

    if (poseTimer > 0) {
      poseTimer -= dt;
      if (poseTimer <= 0) p.pose = 'idle';
    }
    if (sayTimer > 0) {
      sayTimer -= dt;
      if (sayTimer <= 0) p.say = '';
    }
    if (jumpV !== 0 || p.jump > 0) {
      p.jump += jumpV * dt;
      jumpV -= 980 * dt;
      if (p.jump <= 0) {
        if (poseTimer > 0.25 && jumpV < -150) jumpV = 200;
        else jumpV = 0;
        p.jump = 0;
      }
    }

    if (view.shakeTime > 0) {
      view.shakeTime = Math.max(0, view.shakeTime - dt);
      const m = view.shakeTime * 26;
      view.shake.x = Math.sin(view.t * 62) * m;
      view.shake.y = Math.cos(view.t * 49) * m * 0.55;
    } else {
      view.shake.x = 0;
      view.shake.y = 0;
    }
    if (view.flash > 0) view.flash = Math.max(0, view.flash - dt * 2.6);

    for (let i = view.particles.length - 1; i >= 0; i--) {
      const q = view.particles[i];
      q.life -= dt;
      if (q.life <= 0) {
        view.particles.splice(i, 1);
        continue;
      }
      q.vy += q.g * dt;
      q.x += q.vx * dt;
      q.y += q.vy * dt;
      q.rot += dt * 3;
    }

    if (layout) {
      const cardRect = state.screen === 'card' ? document.getElementById('card').getBoundingClientRect() : null;
      /* 寬螢幕：把登山客移到卡片旁邊。窄螢幕放不下，改把場景往上抬。 */
      const beside = cardRect && cardRect.left >= 130;
      let target;
      if (beside) {
        target = p.x - cardRect.left / 2 / layout.z + layout.vw / 2;
      } else if (state.screen === 'start' || state.screen === 'loading') {
        const wide = layout.vw > layout.vh;
        target = p.x + (wide ? -layout.vw * 0.2 : 0);
      } else {
        target = p.x + p.dir * Math.min(120, layout.vw * 0.12) + view.pan;
      }
      const lo = layout.vw * 0.3;
      const hi = FINISH_X + 260;
      view.cam.x += (clamp(target, lo, hi) - view.cam.x) * Math.min(1, dt * 4.5);

      let liftTarget = 0;
      if (cardRect && !beside) {
        const headY = (world.playerY(layout, p.x, p.d) - 120) * layout.z;
        const feetY = (world.playerY(layout, p.x, p.d) + 6) * layout.z;
        const stageTop = document.getElementById('hud').getBoundingClientRect().bottom;
        const over = feetY - (cardRect.top - 8);
        const maxLift = Math.max(0, headY - stageTop);
        liftTarget = clamp(over, 0, maxLift) / layout.z;
      }
      view.lift += (liftTarget - view.lift) * Math.min(1, dt * 5);
    }
  }

  function updateAttract(dt) {
    const p = state.player;
    p.moving = true;
    p.dir = 1;
    p.phase += dt * 8;
    p.x += dt * 54;
    if (p.x > 1250) p.x = 760;
  }

  function update(dt) {
    updateCommon(dt);
    if (state.screen === 'play') {
      updatePlayer(dt);
      updateNpcSpeech();
      updateSection();
      updateEvents();
    } else if (state.screen === 'start' || state.screen === 'loading') {
      updateAttract(dt);
    }
    if (state.screen === 'play' || state.screen === 'card') {
      const p = state.player;
      ui.updateHud(p.x, core.altitudeAt(p.x), core.sectionAt(p.x).name, state.riskView);
    }
  }

  /* 繪製 ---------------------------------------------------------- */
  function resize() {
    const w = Math.max(1, canvas.clientWidth);
    const h = Math.max(1, canvas.clientHeight);
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    layout = world.makeLayout(w, h);
    sizeEndingCanvas();
    needsRedraw = true;
  }

  function sizeEndingCanvas() {
    if (state.screen !== 'ending') return;
    const w = Math.max(1, endingCanvas.clientWidth);
    const h = Math.max(1, endingCanvas.clientHeight);
    endingCanvas.width = Math.round(w * dpr);
    endingCanvas.height = Math.round(h * dpr);
    endingKey = `${w}x${h}`;
  }

  function drawScene() {
    ctx.setTransform(dpr * layout.z, 0, 0, dpr * layout.z, 0, 0);
    world.render(ctx, layout, {
      t: view.t,
      cam: view.cam,
      lift: view.lift,
      shake: view.shake,
      flash: view.flash,
      riskView: state.riskView,
      decor: view.decor,
      npcs: view.npcs,
      events: state.events,
      eventIndex: state.eventIndex,
      nearEvent: state.nearEvent,
      player: state.player,
      walkTarget: view.walkTarget,
      particles: view.particles,
      npcSpeech: state.screen === 'play' && !state.player.say ? view.npcSpeech : null,
      topSafe: (document.getElementById('hud').getBoundingClientRect().bottom + 22) / layout.z,
    });
  }

  function drawEnding() {

:root {
  --ink: #4d4037;
  --ink-soft: #7c6c5f;
  --paper: #fffdf6;
  --cream: #fbf3e0;
  --line: #eadfc8;
  --orange: #f08a57;
  --orange-deep: #d96f3e;
  --green: #4fa871;
  --green-soft: #e4f5e4;
  --red: #d9483f;
  --red-soft: #fde8e4;
  --sky: #a9ddf5;
  --shadow: 0 8px 26px rgba(90, 70, 50, .2);
  --font: 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', 'Noto Sans CJK TC', sans-serif;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
[hidden] { display: none !important; }

html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  overscroll-behavior: none;
  background: var(--sky);
  color: var(--ink);
  font-family: var(--font);
  font-size: 16px;
  line-height: 1.6;
}

#app {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
}

#scene {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
  cursor: pointer;
}

#stage {
  position: relative;
  flex: 1;
  min-height: 0;
  pointer-events: none;
}
#stage > * { pointer-events: auto; }
#stage > #toasts, #stage > #controls { pointer-events: none; }
#controls > * { pointer-events: auto; }

#legal {
  position: relative;
  flex: none;
  padding: 3px 12px calc(3px + env(safe-area-inset-bottom));
  background: rgba(255, 253, 246, .84);
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.4;
  text-align: center;
}

button { font-family: inherit; color: inherit; }

.btn {
  min-height: 48px;
  padding: 10px 22px;
  border: 2px solid var(--line);
  border-radius: 16px;
  background: var(--paper);
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: transform .12s ease, background .15s ease;
}
.btn:hover:not(:disabled) { background: var(--cream); transform: translateY(-1px); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: .62; cursor: default; }
.btn-primary {
  border-color: var(--orange-deep);
  background: var(--orange);
  color: #fff;
  box-shadow: 0 4px 0 var(--orange-deep);
}
.btn-primary:hover:not(:disabled) { background: #f49866; }
.btn-big { font-size: 19px; min-height: 56px; }
.btn-small { min-height: 40px; padding: 6px 14px; font-size: 14px; }
.btn-ghost { background: transparent; color: var(--ink-soft); }
.btn-sos { background: var(--red); border-color: #b5362f; box-shadow: 0 4px 0 #b5362f; }
.btn-sos:hover:not(:disabled) { background: #e2574e; }
:focus-visible { outline: 3px solid #4f8fd1; outline-offset: 2px; }
#card:focus { outline: none; }

.icon-btn {
  width: 44px;
  height: 44px;
  flex: none;
  display: grid;
  place-items: center;
  padding: 0;
  border: 2px solid var(--line);
  border-radius: 14px;
  background: var(--paper);
  color: var(--ink-soft);
  cursor: pointer;
}
.icon-btn.is-on { color: var(--orange-deep); border-color: var(--orange); }

/* HUD ------------------------------------------------------------ */
#hud {
  position: absolute;
  top: calc(10px + env(safe-area-inset-top));
  left: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  pointer-events: none;
}
#hud > * { pointer-events: auto; }

.hud-route, .hud-risk {
  background: rgba(255, 253, 246, .93);
  border-radius: 16px;
  box-shadow: 0 3px 12px rgba(90, 70, 50, .15);
}
.hud-route { flex: 1 1 56%; min-width: 0; padding: 7px 14px 11px; }
.hud-route-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; white-space: nowrap; }
.hud-route-top strong { font-size: 15px; }
.hud-route-top span { font-size: 13px; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

.route-bar { position: relative; height: 9px; margin-top: 4px; border-radius: 6px; background: #eadfc8; }
.route-fill { height: 100%; width: 0; border-radius: 6px; background: linear-gradient(90deg, #8fd0a0, #5fa781); }
.route-tick { position: absolute; top: -2px; width: 2px; height: 13px; background: rgba(120, 100, 80, .42); }
.route-dot {
  position: absolute;
  top: 50%;
  left: 0;
  width: 15px;
  height: 15px;
  margin: -7.5px 0 0 -7.5px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: var(--orange);
  box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
}

.hud-risk { flex: 1 1 34%; min-width: 150px; display: flex; align-items: center; gap: 8px; padding: 7px 12px; }
.risk-body { flex: 1; min-width: 0; }
.risk-top { display: flex; justify-content: space-between; align-items: baseline; font-size: 13px; color: var(--ink-soft); white-space: nowrap; }
.risk-top b { font-size: 17px; color: var(--ink); font-variant-numeric: tabular-nums; }
.risk-bar { height: 11px; border-radius: 6px; background: #eadfc8; overflow: hidden; }
.risk-fill { height: 100%; width: 0; border-radius: 6px; }
.hud-risk.bump { animation: bump .5s ease; }
.hud-risk.is-danger #risk-face { animation: pulse .8s ease-in-out infinite; }
.hud-btns { display: flex; gap: 8px; flex: none; }

@keyframes bump {
  0% { transform: scale(1); }
  30% { transform: scale(1.09); box-shadow: 0 0 0 4px rgba(217, 72, 63, .4); }
  100% { transform: scale(1); }
}
@keyframes pulse { 50% { transform: scale(1.14); } }

/* 提示與 toast ---------------------------------------------------- */
#toasts {
  position: absolute;
  top: calc(84px + env(safe-area-inset-top));
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  z-index: 4;
}
.toast {
  padding: 7px 18px;
  border-radius: 999px;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 3px 12px rgba(90, 70, 50, .2);
  font-size: 15px;
  font-weight: 700;
  animation: toast-in .24s ease;
  transition: opacity .35s ease;
}
.toast.out { opacity: 0; }
.toast.good { color: #2f8a53; }
.toast.warn { color: #c0532b; }
.toast.stage { color: #5a7f6c; font-size: 17px; }
@keyframes toast-in { from { transform: translateY(-10px); opacity: 0; } }

#prompt {
  position: absolute;
  left: 50%;
  bottom: 74px;
  transform: translateX(-50%);
  z-index: 4;
  max-width: 90%;
  min-height: 44px;
  padding: 8px 20px;
  border: 2px solid var(--orange);
  border-radius: 999px;
  background: var(--paper);
  color: var(--orange-deep);
  font-size: 15px;
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  box-shadow: 0 3px 12px rgba(90, 70, 50, .2);
  animation: glow 1.2s ease-in-out infinite;
}
@keyframes glow { 50% { box-shadow: 0 0 0 6px rgba(240, 138, 87, .35); } }

/* 操作區 --------------------------------------------------------- */
#controls { position: absolute; inset: 0; }

#joy {
  position: absolute;
  left: 18px;
  bottom: 18px;
  width: 124px;
  height: 124px;
  border: 3px solid rgba(255, 253, 246, .85);
  border-radius: 50%;
  background: rgba(255, 253, 246, .34);
  touch-action: none;
  display: none;
  place-items: center;
}
#joy-knob {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: rgba(255, 253, 246, .96);
  box-shadow: 0 3px 8px rgba(90, 70, 50, .3);
}

#btn-interact {
  position: absolute;
  right: 18px;
  bottom: 24px;
  width: 84px;
  height: 84px;
  border: 3px solid rgba(255, 253, 246, .9);
  border-radius: 50%;
  background: rgba(190, 180, 165, .78);
  color: #fff;
  font-size: 18px;
  font-weight: 800;
  cursor: pointer;
  display: none;
  place-items: center;
  padding: 0;
  touch-action: manipulation;
}
#btn-interact.is-ready { background: var(--orange); animation: glow 1s ease-in-out infinite; }

#actions {
  position: absolute;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  display: flex;
  gap: 8px;
}
.act-btn {
  min-height: 38px;
  padding: 4px 12px 4px 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  border: 0;
  border-radius: 999px;
  background: rgba(255, 253, 246, .88);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  touch-action: manipulation;
}
.act-btn kbd {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--cream);
  font: inherit;
  font-size: 13px;
  color: var(--ink-soft);
}
#hints {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 4px;
  margin: 0;
  color: #fff;
  font-size: 13px;
  text-align: center;
  text-shadow: 0 1px 3px rgba(40, 40, 30, .6);
  pointer-events: none;
}

body.touch #joy, body.touch #btn-interact { display: grid; }
body.touch #hints { display: none; }
body.touch .act-btn { padding: 4px 14px; min-height: 40px; }
body.touch .act-btn kbd { display: none; }

@media (max-width: 760px) {
  #joy, #btn-interact { display: grid; }
  #hints { display: none; }
  #actions { bottom: 148px; }
  .act-btn { padding: 4px 14px; min-height: 40px; }
  .act-btn kbd { display: none; }
  #prompt { bottom: 196px; font-size: 14px; }
  #hud { flex-wrap: wrap; gap: 6px 8px; left: 8px; right: 8px; }
  .hud-route { flex: 1 1 100%; }
  .hud-risk { flex: 1 1 0; }
  #toasts { top: calc(124px + env(safe-area-inset-top)); }
}
/* 小手機的步道離操作區太近，把可有可無的小動作收起來 */
@media (max-width: 760px) and (max-height: 640px) and (orientation: portrait) {
  #actions { display: none; }
}

/* 事件卡片 ------------------------------------------------------- */
.card {
  position: absolute;
  left: 50%;
  bottom: 12px;
  width: min(640px, calc(100% - 20px));
  max-height: calc(100% - 92px - env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  transform: translateX(-50%);
  z-index: 5;
  border: 3px solid #fff;
  border-radius: 24px;
  background: var(--paper);
  box-shadow: var(--shadow);
  animation: card-in .28s cubic-bezier(.2, 1.3, .5, 1);
}
.card.is-right { border-color: #9fdcb0; }
.card.is-wrong { border-color: #f4a79f; }
.card.shake { animation: card-shake .46s ease; }

@keyframes card-in { from { transform: translateX(-50%) translateY(30px) scale(.97); opacity: 0; } }
@keyframes card-shake {
  15% { transform: translateX(calc(-50% - 9px)); }
  35% { transform: translateX(calc(-50% + 8px)); }
  55% { transform: translateX(calc(-50% - 6px)); }
  75% { transform: translateX(calc(-50% + 4px)); }
  100% { transform: translateX(-50%); }
}

.card-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  touch-action: pan-y;
  padding: 16px 18px 14px;
}
.card-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.tag {
  display: inline-block;
  padding: 2px 11px;
  border-radius: 999px;
  background: #e2f2ea;
  color: #38795a;
  font-size: 13px;
  font-weight: 700;
}
.card-count { color: var(--ink-soft); font-size: 13px; font-variant-numeric: tabular-nums; }
.card h2 { margin: 7px 0 3px; font-size: 21px; line-height: 1.35; }
#card-sit { margin: 0 0 11px; font-size: 16px; }

.opts { display: grid; gap: 8px; }
.opt {
  min-height: 52px;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 13px 8px 9px;
  border: 2px solid var(--line);
  border-radius: 15px;
  background: #fff;
  font-size: 16px;
  line-height: 1.42;
  text-align: left;
  cursor: pointer;
  touch-action: manipulation;
  transition: background .14s ease, border-color .14s ease;
}
.opt:hover:not(:disabled) { background: #fff5e6; border-color: var(--orange); }
.opt:disabled { cursor: default; color: var(--ink); }
.opt-key {
  flex: none;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--cream);
  color: var(--ink-soft);
  font-size: 15px;
  font-weight: 800;
}
.answered .opt:not(.correct):not(.wrong) { opacity: .62; }
.opt.correct { border-color: var(--green); background: var(--green-soft); font-weight: 700; }
.opt.correct .opt-key { background: var(--green); color: #fff; }
.opt.wrong { border-color: var(--red); background: var(--red-soft); }
.opt.wrong .opt-key { background: var(--red); color: #fff; }

.fb { margin-top: 11px; padding: 11px 14px; border-radius: 15px; background: var(--cream); }
.is-right .fb { background: var(--green-soft); }
.is-wrong .fb { background: var(--red-soft); }
.fb-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 17px; }
.fb-gain { color: #2f8a53; font-weight: 800; }
.fb-loss { color: var(--red); font-weight: 800; }
#fb-why { margin: 4px 0 0; font-size: 15.5px; }
.fb-src { margin: 5px 0 0; font-size: 12.5px; color: var(--ink-soft); }
.fb-src:empty { display: none; }

.card-foot { flex: none; padding: 10px 18px 15px; border-top: 2px solid var(--cream); }
.card-foot .btn { width: 100%; }

@media (max-width: 760px) {
  .card { max-height: calc(100% - 142px - env(safe-area-inset-top)); }
}

@media (max-height: 520px) and (orientation: landscape) {
  .card { width: min(880px, calc(100% - 16px)); bottom: 4px; max-height: calc(100% - 66px); border-radius: 18px; }
  .card-scroll { display: grid; grid-template-columns: 2fr 3fr; gap: 14px; padding: 10px 14px; }
  .card-main { position: sticky; top: 0; align-self: start; }
  .card h2 { font-size: 18px; }
  #card-sit { font-size: 15px; margin-bottom: 0; }
  .opt { min-height: 48px; font-size: 15px; padding: 4px 10px 4px 7px; }
  .opts { gap: 6px; }
  .card-foot { padding: 6px 14px 8px; }
  #hud { top: 4px; }
  .hud-route { padding: 3px 12px 7px; }
  .hud-risk { padding: 3px 10px; }
  #risk-face { width: 28px; height: 28px; }
  #toasts { top: 58px; }
  #joy { width: 104px; height: 104px; bottom: 8px; left: 12px; }
  #joy-knob { width: 46px; height: 46px; }
  #btn-interact { width: 70px; height: 70px; bottom: 10px; }
  #actions { bottom: 14px; }
  #prompt { bottom: 60px; }
}

/* 開始畫面 ------------------------------------------------------- */
.screen { position: absolute; inset: 0; z-index: 6; pointer-events: none !important; }
.screen > * { pointer-events: auto; }

#start-screen { display: flex; align-items: center; padding: 20px 20px 20px clamp(20px, 7vw, 110px); }
.start-card {
  position: relative;
  width: min(430px, 100%);
  max-height: 100%;
  overflow-y: auto;
  padding: 24px 28px;
  border: 3px solid #fff;
  border-radius: 28px;
  background: rgba(255, 253, 246, .95);
  box-shadow: var(--shadow);
}
.start-kicker { margin: 0; color: var(--orange-deep); font-size: 14px; font-weight: 700; }
.start-card h1 { margin: 0; font-size: clamp(38px, 7vw, 54px); line-height: 1.2; letter-spacing: .06em; color: #4a7c63; }
.start-sub { margin: 6px 0 16px; font-size: 16px; }
.start-btns { display: grid; gap: 10px; }
.start-sound { position: absolute; top: 14px; right: 14px; }

.load-notice { margin-top: 12px; padding: 11px 13px; border-radius: 14px; background: #fff1dc; font-size: 14.5px; }
.load-notice p { margin: 0 0 8px; }

@media (max-width: 760px) and (orientation: portrait) {
  #start-screen { align-items: flex-start; padding: calc(16px + env(safe-area-inset-top)) 14px 14px; }
  .start-card { width: 100%; padding: 18px 20px; }
}
@media (max-height: 520px) and (orientation: landscape) {
  #start-screen { padding: 8px 8px 8px 16px; }
  .start-card { width: 340px; padding: 10px 16px; }
  .start-card h1 { font-size: 30px; }
  .start-kicker { display: none; }
  .start-sub { font-size: 13px; margin: 2px 0 8px; }
  .start-btns { gap: 6px; }
  .start-btns .btn { min-height: 44px; padding: 4px 12px; font-size: 15px; }
}

/* 結局畫面 ------------------------------------------------------- */
#ending-screen {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: rgba(70, 70, 66, .45);
  pointer-events: auto !important;
}
.ending-panel {
  width: min(1040px, 100%);
  height: min(680px, 100%);
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  border: 3px solid #fff;
  border-radius: 26px;
  background: var(--paper);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.ending-left { display: flex; flex-direction: column; padding: 18px 22px; overflow-y: auto; min-height: 0; }
#ending-art { flex: none; width: 100%; height: clamp(180px, 34vh, 250px); border-radius: 18px; display: block; }
.ending-kicker { margin: 12px 0 0; color: var(--orange-deep); font-size: 14px; font-weight: 700; }
.ending-left h2 { margin: 0; font-size: 28px; line-height: 1.3; }
#ending-msg { margin: 4px 0 12px; font-size: 15.5px; }
.ending-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.ending-stats > div { padding: 6px 4px; border-radius: 13px; background: var(--cream); text-align: center; }
.ending-stats span { display: block; color: var(--ink-soft); font-size: 13px; }
.ending-stats b { font-size: 23px; line-height: 1.3; font-variant-numeric: tabular-nums; }
.ending-best { margin: 9px 0 0; color: var(--ink-soft); font-size: 14px; }
.ending-best:empty { display: none; }
.ending-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
.badge-chip { padding: 2px 11px; border-radius: 999px; background: #fff0c9; color: #93651a; font-size: 13px; font-weight: 700; }
.ending-btns { display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-top: auto; padding-top: 13px; }

.ending-right { display: flex; flex-direction: column; min-height: 0; padding: 18px 20px; background: #fbf7ea; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; }
.ending-right h3 { margin: 0; font-size: 21px; }
.summary-note { margin: 0 0 10px; color: var(--ink-soft); font-size: 14px; }
#summary-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.sum-item { padding: 11px 14px; border: 2px solid var(--line); border-radius: 16px; background: #fff; }
.sum-item.ok { border-color: #bfe6c9; }
.sum-item.ng { border-color: #f5c4bd; }
.sum-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.sum-res { font-size: 13.5px; font-weight: 800; }
.sum-res.ok { color: #2f8a53; }
.sum-res.ng { color: var(--red); }
.sum-item h4 { margin: 5px 0 1px; font-size: 17px; }
.sum-sit { margin: 0 0 5px; color: var(--ink-soft); font-size: 14px; }
.sum-item dl { margin: 0; font-size: 14.5px; }
.sum-item dt { margin-top: 4px; color: var(--ink-soft); font-size: 12.5px; font-weight: 700; }
.sum-item dd { margin: 0; }
.c-ok { color: #2f8a53; font-weight: 700; }
.c-ng { color: var(--red); font-weight: 700; }
.sum-src { margin: 5px 0 0; color: var(--ink-soft); font-size: 12.5px; }

@media (max-width: 760px), (max-height: 520px) {
  #ending-screen { padding: 0; }
  .ending-panel { display: block; width: 100%; height: 100%; border: 0; border-radius: 0; overflow-y: auto; overscroll-behavior: contain; touch-action: pan-y; }
  .ending-left, .ending-right { overflow: visible; }
  #ending-art { height: 200px; }
  .ending-left { padding: 12px 14px; }
  .ending-right { padding: 14px; }
  .ending-btns { position: sticky; bottom: 0; margin: 11px -14px -12px; padding: 10px 14px; background: var(--paper); border-top: 2px solid var(--cream); z-index: 2; }
}

/* 彈窗 ---------------------------------------------------------- */
.modal {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: grid;
  place-items: center;
  padding: 14px;
  background: rgba(70, 70, 66, .45);
}
.modal-box {
  position: relative;
  width: min(540px, 100%);
  max-height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
  touch-action: pan-y;
  padding: 20px 22px;
  border: 3px solid #fff;
  border-radius: 24px;
  background: var(--paper);
  box-shadow: var(--shadow);
}
.modal-box h2 { margin: 0 44px 10px 0; font-size: 23px; }
.modal-x {
  position: absolute;
  top: 11px;
  right: 11px;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: var(--cream);
  color: var(--ink-soft);
  cursor: pointer;
}
.help-list { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 8px 13px; font-size: 15.5px; }
.help-list dt { font-weight: 800; color: #4a7c63; }
.help-list dd { margin: 0; }
.help-note { margin: 13px 0 0; padding: 9px 13px; border-radius: 13px; background: var(--cream); font-size: 15px; }

.records-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.records-stats > div { padding: 7px 4px; border-radius: 13px; background: var(--cream); text-align: center; }
.records-stats span { display: block; color: var(--ink-soft); font-size: 13px; }
.records-stats b { font-size: 23px; }
.records-best { margin-top: 10px; padding: 9px 13px; border-radius: 13px; background: var(--green-soft); }
.records-best span, .records-best small { display: block; color: var(--ink-soft); font-size: 13px; }
.records-seen { margin: 9px 0 0; font-size: 14.5px; color: var(--ink-soft); }
.records h3 { margin: 12px 0 7px; font-size: 17px; }
.badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; margin-bottom: 13px; }
.badge { padding: 8px 12px; border: 2px dashed var(--line); border-radius: 13px; color: var(--ink-soft); }
.badge strong { display: block; font-size: 15px; }
.badge span { font-size: 12.5px; line-height: 1.4; display: block; }
.badge.on { border: 2px solid #efc76a; background: #fff6da; color: var(--ink); }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}


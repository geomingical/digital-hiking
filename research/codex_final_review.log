    border-radius: 12px;
    background: #fff;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
  }
  .mtn-chip.on { border-color: var(--brand); background: #fdf0e6; color: var(--brand); }
  .mtn-grid { display: block; }
  .mtn-card { display: none; }
  .mtn-card.active { display: flex; }
  .mtn-banner { height: 104px; }
  .mtn-top h3 { font-size: 20px; }
  .mtn-intro { font-size: 14.5px; }
  .mtn-facts { font-size: 14.5px; gap: 4px 8px; }

  .fc-wrap { display: block; }
  .fc-art { height: 84px; }
  .fc-mtn { margin-top: 5px; font-size: 18px; }
  .fc-sub { margin-bottom: 5px; }
  .season-grid { grid-template-columns: repeat(5, 1fr); gap: 5px; margin-bottom: 8px; }
  .season-btn { min-height: 48px; padding: 2px; border-radius: 11px; }
  .season-btn strong { font-size: 14.5px; }
  .season-btn small { display: none; }
  .season-btn:last-child { grid-column: auto; }
  .fc-card { padding: 9px 11px; }
  .fc-title strong { font-size: 17px; }
  .fc-notice { font-size: 12.5px; line-height: 1.4; }
  .fc-row { padding: 3px 0; }
  .fc-label { font-size: 13.5px; }
  .fc-value b { font-size: 16px; }
  .fc-value small { font-size: 12px; }
  .fc-tips { font-size: 13px; padding: 5px 9px; line-height: 1.45; }

  .gear-layout { display: flex; flex-direction: column; width: 100%; }
  .gear-left { flex: none; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 5px 8px; padding: 6px 10px; border-right: 0; border-bottom: 2px solid var(--cream); overflow: visible; }
  .gear-brief { grid-column: 1 / -1; font-size: 12px; line-height: 1.32; }
  .gear-brief strong { font-size: 13px; }
.gear-brief { display: flex; flex-direction: column; font-size: 13.5px; line-height: 1.4; }
.gear-brief strong { font-size: 14.5px; }
.gear-preview { flex: 1 1 280px; width: 100%; min-height: 230px; max-height: 390px; display: block; border-radius: 16px; }
.gear-meter { padding: 8px 12px 9px; border-radius: 14px; background: #fff; }
.meter-top { display: flex; align-items: baseline; gap: 3px; font-size: 14px; font-weight: 700; }
.meter-num { margin-left: 6px; font-size: 27px; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--brand); }
.meter-cap { color: var(--ink-soft); }
.meter-bar { position: relative; height: 10px; border-radius: 5px; background: #eadfc8; overflow: hidden; }
.meter-bar i { display: block; height: 100%; border-radius: 5px; transition: width .2s ease; }
.gear-meter > .meter-bar { margin-top: 3px; }
.meter-why { margin: 6px 0 0; padding: 0; list-style: none; font-size: 13px; line-height: 1.45; }
.meter-why li { padding: 1px 0; }
.meter-why li.ok { color: #237a45; }
.gear-rec { width: 100%; min-height: 44px; flex: none; }
.gear-right { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.gear-tabs { flex: none; display: grid; grid-template-columns: repeat(3, 1fr); padding: 8px 14px 0; gap: 6px; border-bottom: 2px solid var(--cream); }
  #actions { display: none; }
  #prompt { bottom: 144px; }
}

/* 事件卡片 ------------------------------------------------------- */
.card {
  position: absolute;
  left: 50%;
  bottom: 12px;
  width: min(640px, calc(100% - 20px));
  max-height: calc(100% - 92px - env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
  transform: translateX(var(--card-x, -50%));
  z-index: 5;
  border: 3px solid #fff;
  border-radius: 24px;
  background: var(--paper);
  box-shadow: var(--shadow);
}

/* 保命觀念：題卡徽章、作答重點、結局清單 */
.card.is-key { border-color: #f7b9a4; }
.card.is-key.is-right { border-color: #9fdcb0; }
.card.is-key.is-wrong { border-color: #f4a79f; }
.key-strip { flex: none; padding: 8px 14px 7px; border-radius: 21px 21px 0 0; background: linear-gradient(90deg, #ffe3d3, #fff2e4); border-bottom: 2px solid #f8c9b4; }
.key-badge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  max-width: 100%;
  padding: 2px 13px 2px 3px;
  border: 2px solid #f3a48c;
  border-radius: 999px;
  background: #fffaf4;
  color: #a92f28;
}
.key-ring { flex: none; display: block; }
.key-badge-text { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 7px; min-width: 0; line-height: 1.3; }
.key-badge small { font-size: 12.5px; font-weight: 800; letter-spacing: .04em; }
.key-badge b { font-size: 15px; font-weight: 800; }
.fb-key { margin: 7px 0 4px; padding: 8px 11px; border: 2px solid #f3a48c; border-radius: 12px; background: #fff6ee; }
.fb-key p { margin: 0; }
.fb-key-point { font-size: 15.5px; line-height: 1.55; font-weight: 600; color: #6e332a; }
.fb-key-point b { display: inline-block; margin-right: 6px; padding: 0 8px; border-radius: 999px; background: #c9362f; color: #fff; font-size: 13px; font-weight: 800; line-height: 1.6; }
.fb-key-src { margin-top: 3px !important; font-size: 13px; line-height: 1.5; color: #6b5c50; }
.fb-key-src a, .fb-src a, .sum-src a { color: #8a4326; text-underline-offset: 2px; }
.ending-key { margin: 0 0 10px; padding: 9px 12px 11px; border: 2px solid #f3a48c; border-radius: 15px; background: #fff6ee; }
    }
  }


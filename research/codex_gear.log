('fire_kit','防水收納用火工具',40,'用火工具','只在合法安全處使用，禁火區不點火。','紅色小防水盒',{'has_fire_kit':True}),
('repair_kit','修補工具組',100,'修補工具','膠帶與簡易工具供暫時處理，故障仍要評估撤退。','灰色膠帶環',{'has_repair_kit':True}),
